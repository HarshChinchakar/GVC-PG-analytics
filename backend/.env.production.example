# Render environment variables. Set these in the dashboard, not in a file.

ENVIRONMENT=production
DEBUG=false

# Supabase Postgres via the TRANSACTION POOLER (port 6543).
# Note the +psycopg driver prefix, and percent-encode any special characters
# in the password: * becomes %2A, @ becomes %40, # becomes %23.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# The Vercel origin(s) allowed to call this API. Comma-separated, no trailing slash.
CORS_ORIGINS=https://your-app.vercel.app
