# Copy to .env and adjust. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# --- Development: SQLite (default, no setup needed) ---
# Leave DATABASE_URL unset to use ./pg_portal.db

# --- Production: Supabase Postgres ---
# Use the *pooled* connection string (port 6543). The direct 5432 endpoint
# exhausts its connection limit quickly on small instances.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

DATABASE_ECHO=false

# Business rule defaults. Each location can override these in its own row.
DEFAULT_NOTICE_PERIOD_DAYS=30
DEFAULT_DEPOSIT_DEDUCTION=1000

# --- Supabase Auth (production only) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=   # server-side only, never sent to the browser
